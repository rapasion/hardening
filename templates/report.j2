{% set all_tasks = host_results | map(attribute='tasks') | flatten %}

<h2>Global Summary</h2>
<ul>
    <li><span class="ok">OK:</span> {{ all_tasks | rejectattr('result.failed') | rejectattr('result.changed') | list | length }}</li>
    <li><span class="changed">Changed:</span> {{ all_tasks | selectattr('result.changed') | list | length }}</li>
    <li><span class="failed">Failed:</span> {{ all_tasks | selectattr('result.failed') | list | length }}</li>
</ul>

{% for host in host_results %}
  <h2>Host: {{ host.host }}</h2>
  <p>
    Host Summary:
    ✅ OK={{ host.tasks | rejectattr('result.failed') | rejectattr('result.changed') | list | length }},
    ⚠️ Changed={{ host.tasks | selectattr('result.changed') | list | length }},
    ❌ Failed={{ host.tasks | selectattr('result.failed') | list | length }}
  </p>
  <table>
    <tr>
      <th>Task</th>
      <th>Status</th>
      <th>Details</th>
    </tr>
    {% for task in host.tasks %}
      <tr>
        <td>{{ task.name }}</td>
        <td class="{% if task.result.failed %}failed{% elif task.result.changed %}changed{% else %}ok{% endif %}">
          {% if task.result.failed %}FAILED{% elif task.result.changed %}CHANGED{% else %}OK{% endif %}
        </td>
        <td>{{ task.result.msg | default(task.result.stdout | default(task.result.results | default(''))) }}</td>
      </tr>
    {% endfor %}
  </table>
{% endfor %}
