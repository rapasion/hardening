<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>RHEL 7 Hardening Report</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; }
        h1 { color: #2c3e50; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ccc; padding: 8px; }
        th { background: #f4f4f4; }
        .ok { color: green; font-weight: bold; }
        .changed { color: #e67e22; font-weight: bold; }
        .failed { color: red; font-weight: bold; }
        footer { margin-top: 40px; font-size: 0.9em; color: #555; }
    </style>
</head>
<body>

<h1>RHEL 7 Hardening Report</h1>
<p><strong>Date:</strong> {{ ansible_date_time.date }} {{ ansible_date_time.time }}</p>

<h2>Global Summary</h2>
{% set ok_count = 0 %}
{% set changed_count = 0 %}
{% set failed_count = 0 %}

{% for host in host_results %}
  {% for task in host.tasks %}
    {% if task.result.failed is defined and task.result.failed %}
      {% set failed_count = failed_count + 1 %}
    {% elif task.result.changed is defined and task.result.changed %}
      {% set changed_count = changed_count + 1 %}
    {% else %}
      {% set ok_count = ok_count + 1 %}
    {% endif %}
  {% endfor %}
{% endfor %}

<ul>
    <li><span class="ok">OK:</span> {{ ok_count }}</li>
    <li><span class="changed">Changed:</span> {{ changed_count }}</li>
    <li><span class="failed">Failed:</span> {{ failed_count }}</li>
</ul>

{% for host in host_results %}
  <h2>Host: {{ host.host }}</h2>
  <table>
    <tr>
      <th>Task</th>
      <th>Status</th>
      <th>Details</th>
    </tr>
    {% for task in host.tasks %}
      <tr>
        <td>{{ task.name }}</td>
        <td class="{% if task.result.failed is defined and task.result.failed %}failed{% elif task.result.changed is defined and task.result.changed %}changed{% else %}ok{% endif %}">
          {% if task.result.failed is defined and task.result.failed %}FAILED
          {% elif task.result.changed is defined and task.result.changed %}CHANGED
          {% else %}OK{% endif %}
        </td>
        <td>{{ task.result.msg }}</td>
      </tr>
    {% endfor %}
  </table>
{% endfor %}

<footer>
    <p>Generated by Jenkins job <strong>{{ jenkins_job_name | default('N/A') }}</strong>, 
       build <strong>{{ jenkins_build_number | default('N/A') }}</strong>.</p>
    <p>Build URL: <a href="{{ jenkins_build_url | default('#') }}">{{ jenkins_build_url | default('N/A') }}</a></p>
</footer>

</body>
</html>
