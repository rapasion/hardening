{% set all_tasks = host_results | map(attribute='tasks') | flatten %}

<h2>Global Summary</h2>
<ul>
    <li><span class="ok">OK:</span>
        {{ all_tasks | selectattr('result.failed','equalto',false)
                     | selectattr('result.changed','equalto',false)
                     | list | length }}
    </li>
    <li><span class="changed">Changed:</span>
        {{ all_tasks | selectattr('result.changed','equalto',true) | list | length }}
    </li>
    <li><span class="failed">Failed:</span>
        {{ all_tasks | selectattr('result.failed','equalto',true) | list | length }}
    </li>
</ul>
